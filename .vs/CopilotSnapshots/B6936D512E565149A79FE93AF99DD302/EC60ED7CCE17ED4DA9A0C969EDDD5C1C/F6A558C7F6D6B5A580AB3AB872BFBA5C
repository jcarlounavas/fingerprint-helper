            // Generic path: draw into 24bpp clone and convert.
            using var clone = new Bitmap(width, height, PixelFormat.Format24bppRgb);
            using (var g = Graphics.FromImage(clone))
            {
                g.DrawImage(bmp, 0, 0, width, height);
            }

            var rect24 = new Rectangle(0, 0, width, height);
            var data24 = clone.LockBits(rect24, ImageLockMode.ReadOnly, PixelFormat.Format24bppRgb);
            try
            {
                int stride = Math.Abs(data24.Stride);
                int bytes = stride * height;
                var rgbValues = new byte[bytes];
                Marshal.Copy(data24.Scan0, rgbValues, 0, bytes);

                for (int y = 0; y < height; y++)
                {
                    int row = y * stride;
                    int outRow = y * width;
                    for (int x = 0; x < width; x++)
                    {
                        int idx = row + x * 3; // B,G,R
                        byte b = rgbValues[idx];
                        byte g = rgbValues[idx + 1];
                        byte r = rgbValues[idx + 2];
                        // luminance
                        byte gray = (byte)(0.299 * r + 0.587 * g + 0.114 * b);
                        pixels[outRow + x] = gray;
                    }
                }
            }
            finally
            {
                clone.UnlockBits(data24);
            }

            return pixels;
        }
        [HttpPost("verify")]
        public IActionResult Verify([FromBody] VerifyRequest request)
        {
            if (string.IsNullOrWhiteSpace(request.ProbeImageBase64) ||
        string.IsNullOrWhiteSpace(request.ReferenceImageBase64))
            {
                return BadRequest(new { match = false, score = 0, message = "Missing images" });
            }

            Console.WriteLine($"[Match/verify] received probe length = {request.ProbeImageBase64.Length}, " +
                              $"reference length = {request.ReferenceImageBase64.Length}");

            try
            {
                // Note: decoding and grayscale conversion are handled by helper methods defined below.
                // Small sanity limit on base64 length to avoid extremely large inputs (adjust as needed).
                const int MaxBase64Length = 10_000_000; // ~10M chars
                if (request.ProbeImageBase64.Length > MaxBase64Length || request.ReferenceImageBase64.Length > MaxBase64Length)
                    return BadRequest(new { match = false, score = 0, message = "Image too large" });

                using var probeBmp = DecodeBase64ToBitmap(request.ProbeImageBase64);
                using var refBmp = DecodeBase64ToBitmap(request.ReferenceImageBase64);

                var options = new FingerprintImageOptions { Dpi = 500 }; // adjust if your reader uses a different DPI

                // Convert to grayscale byte arrays (fast paths for 8bpp)
                var probePixels = ToGrayscaleBytes(probeBmp);
                var refPixels = ToGrayscaleBytes(refBmp);

                // Auto-invert detection/override
                bool probeInvert;
                bool refInvert;
                if (request.AutoInvert.HasValue)
                {
                    probeInvert = refInvert = request.AutoInvert.Value;
                }
                else
                {
                    probeInvert = ShouldInvert(probePixels);
                    refInvert = ShouldInvert(refPixels);
                }

                if (probeInvert)
                {
                    InvertPixels(probePixels);
                    Console.WriteLine("[Match/verify] probe image inverted");
                }
                if (refInvert)
                {
                    InvertPixels(refPixels);
                    Console.WriteLine("[Match/verify] reference image inverted");
                }

                var probeImage = new FingerprintImage(
                    probeBmp.Width,
                    probeBmp.Height,
                    probePixels,
                    options
                );
                var refImage = new FingerprintImage(
                    refBmp.Width,
                    refBmp.Height,
                    refPixels,
                    options
                );

                var probeTemplate = new FingerprintTemplate(probeImage);
                var referenceTemplate = new FingerprintTemplate(refImage);

                var matcher = new FingerprintMatcher(probeTemplate);
                double score = matcher.Match(referenceTemplate);

                // Log score for tuning
                Console.WriteLine($"[Match/verify] score = {score}");

                // TEMP threshold for testing; we will tune this based on real scores
                const double threshold = 10.0;
                bool match = score >= threshold;



                return Ok(new { match, score });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { match = false, score = 0, error = ex.Message });
            }
        }
