using Microsoft.AspNetCore.Mvc;
using SourceAFIS;
using System.Drawing;
using System.Text.RegularExpressions;

namespace FingerjetHelper.Controllers
{
    //[ApiController]
    [Route("[controller]")]
    public class MatchController : ControllerBase
    {
        public class VerifyRequest
        {
            // Two fingerprint images as base64 strings (PNG/JPEG, may be plain base64 or data URLs)
            public string ProbeImageBase64 { get; set; } = string.Empty;
            public string ReferenceImageBase64 { get; set; } = string.Empty;
        }

        [HttpPost("verify")]
        public IActionResult Verify([FromBody] VerifyRequest request)
        {
            if (string.IsNullOrWhiteSpace(request.ProbeImageBase64) ||
                string.IsNullOrWhiteSpace(request.ReferenceImageBase64))
            {
                return BadRequest(new { match = false, score = 0, message = "Missing images" });
            }

            Console.WriteLine($"[Match/verify] received probe length = {request.ProbeImageBase64.Length}, " +
                              $"reference length = {request.ReferenceImageBase64.Length}");

            try
            {
                using var probeBmp = Decode(request.ProbeImageBase64);
                using var refBmp = Decode(request.ReferenceImageBase64);

                var options = new FingerprintImageOptions { Dpi = 500 }; // adjust if your reader uses a different DPI

                var probeImage = new FingerprintImage(
                    probeBmp.Width,
                    probeBmp.Height,
                    ToGrayscaleBytes(probeBmp),
                    options
                );
                var refImage = new FingerprintImage(
                    refBmp.Width,
                    refBmp.Height,
                    ToGrayscaleBytes(refBmp),
                    options
                );

                var probeTemplate = new FingerprintTemplate(probeImage);
                var referenceTemplate = new FingerprintTemplate(refImage);

                var matcher = new FingerprintMatcher(probeTemplate);
                double score = matcher.Match(referenceTemplate);

                Console.WriteLine($"[Match/verify] score = {score}");

                const double threshold = 10.0;
                bool match = score >= threshold;

                return Ok(new { match, score });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { match = false, score = 0, error = ex.Message });
            }
        }

        /// <summary>
        /// Decode base64 (optionally data URL) into Bitmap. Strips whitespace and data URL prefix.
        /// </summary>
        private static Bitmap Decode(string base64)
        {
            if (string.IsNullOrWhiteSpace(base64))
                throw new ArgumentException("Empty base64");

            base64 = base64.Trim();

            // Remove surrounding quotes if present (e.g. from JSON/console)
            if (base64.StartsWith("\"") && base64.EndsWith("\"") && base64.Length > 2)
                base64 = base64.Substring(1, base64.Length - 2);

            // Remove ALL whitespace (spaces, tabs, newlines, etc.)
            base64 = Regex.Replace(base64, @"\s+", "");

            // Strip data URL prefix (data:image/png;base64,...)
            if (base64.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
            {
                var parts = base64.Split(',', 2);
                base64 = parts.Length == 2 ? parts[1].Trim() : base64;
                base64 = Regex.Replace(base64, @"\s+", "");
            }

            byte[] bytes;
            try
            {
                bytes = Convert.FromBase64String(base64);
            }
            catch (FormatException ex)
            {
                throw new ArgumentException($"Invalid base64: {ex.Message}", ex);
            }

            using var ms = new MemoryStream(bytes);
            return new Bitmap(ms);
        }

        private static byte[] ToGrayscaleBytes(Bitmap bmp)
        {
            var pixels = new byte[bmp.Width * bmp.Height];

            for (int y = 0; y < bmp.Height; y++)
            {
                for (int x = 0; x < bmp.Width; x++)
                {
                    var color = bmp.GetPixel(x, y);
                    var gray = (byte)(0.299 * color.R + 0.587 * color.G + 0.114 * color.B);
                    pixels[y * bmp.Width + x] = gray;
                }
            }

            return pixels;
        }
    }
}